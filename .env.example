VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Used to encrypt sensitive payment settings before saving them to system_settings.
# Use a long random value in production and keep it out of the database.
VITE_PAYMENT_SETTINGS_ENCRYPTION_KEY=

# Optional AI provider settings.
# Groq's previous llama-3.3-70b-versatile default may require Enterprise access.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
OPENROUTER_API_KEY=
OPENROUTER_MODEL=deepseek/deepseek-chat-v3-0324:free
